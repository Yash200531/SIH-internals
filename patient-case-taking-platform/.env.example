# Local development only. Never reuse these placeholder credentials outside a
# developer machine; production values must come from a secrets manager.
# Infrastructure
POSTGRES_DB=notmid
POSTGRES_USER=notmid
POSTGRES_PASSWORD=notmid-local-only
MINIO_ROOT_USER=notmid-local
MINIO_ROOT_PASSWORD=notmid-local-only-change-me
MINIO_CONSOLE_PORT=9002

# Application
APP_ENV=development
AUTH_PROVIDER=demo
# Configure pinned issuer, audience, origins and allowed internal roles; see IDENTITY-API.md.
CLERK_APPLICATIONS_JSON=[]
# Clinician frontend: public settings are embedded at build time; rebuild after changes.
CLINICIAN_AUTH_PROVIDER=demo
CLINICIAN_CLERK_PUBLISHABLE_KEY=
CLINICIAN_CLERK_SECRET_KEY=
CLINICIAN_CLERK_AUDIENCE=clinician-app
CLINICIAN_CLERK_AUTHORIZED_PARTIES=http://localhost:3001
CLINICIAN_API_URL=http://localhost:8000
DATABASE_URL=postgresql://notmid:notmid-local-only@localhost:5432/notmid
DATABASE_MAINTENANCE_URL=
MONGODB_URL=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_SERVER_SIDE_ENCRYPTION=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
ENABLE_DEMO_ROUTES=false
DOCUMENT_WORKFLOW_ENABLED=false
TRIAGE_WORKFLOW_ENABLED=false
TRIAGE_EVENT_TOPIC=clinical.triage.v1
DOCUMENT_UPLOAD_GRANT_TTL_SECONDS=300
DOCUMENT_PREVIEW_GRANT_TTL_SECONDS=300
DOCUMENT_UPLOAD_SESSION_TTL_SECONDS=900
DOCUMENT_UPLOAD_CLEANUP_INTERVAL_SECONDS=60
DOCUMENT_UPLOAD_CLEANUP_BATCH_SIZE=100
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
DOCUMENT_SCAN_MAX_BYTES=10485760
DOCUMENT_SCAN_BATCH_SIZE=10
DOCUMENT_SCAN_POLL_INTERVAL_SECONDS=2
DOCUMENT_NORMALIZATION_MAX_PAGES=20
DOCUMENT_NORMALIZATION_MAX_PIXELS_PER_PAGE=25000000
DOCUMENT_NORMALIZATION_MAX_TOTAL_PIXELS=100000000
DOCUMENT_NORMALIZATION_RENDER_DPI=200
DOCUMENT_NORMALIZATION_TIMEOUT_SECONDS=30
DOCUMENT_NORMALIZATION_BATCH_SIZE=2
DOCUMENT_NORMALIZATION_POLL_INTERVAL_SECONDS=2
OCR_PROVIDER=paddleocr_fast
TTS_PROVIDER=mock
TTS_WARMUP_ON_START=false
TTS_SYNTHESIS_TIMEOUT_SECONDS=180
# Real TTS provider — AI4Bharat Indic Parler-TTS (21 Indian languages)
# Requirements: pip install -e ".[ai-tts]"
# Accept gated model terms at: https://huggingface.co/ai4bharat/indic-parler-tts
# Then set HUGGINGFACE_TOKEN and switch TTS_PROVIDER:
# TTS_PROVIDER=indic
# INDIC_TTS_MODEL=ai4bharat/indic-parler-tts
# INDIC_TTS_DEVICE=
#
# Real local IndicF5 (11 Indian languages; Hindi is the supported kiosk path):
# API_BUILD_TARGET=tts
# TTS_PROVIDER=indicf5
# TTS_WARMUP_ON_START=true
# INDICF5_MODEL=ai4bharat/IndicF5
# INDICF5_MODEL_REVISION=ba85abedf18dc479a447eaa0eccbd76ab78a47d5
# INDICF5_DEVICE=cuda
# INDICF5_REFERENCE_AUDIO_PATH=
# INDICF5_LOCAL_FILES_ONLY=false
# INDICF5_DISABLE_COMPILE=true
# INDICF5_NFE_STEPS=16
# INDICF5_CACHE_ENTRIES=32
OCR_LANGUAGE=en
OCR_ALLOW_COMPLEX_LAYOUT_PROVIDER=false
PADDLE_PDX_MODEL_SOURCE=BOS
OCR_ARTIFACT_DATABASE=notmid
OCR_ARTIFACT_COLLECTION=document_ocr_artifacts
EXTRACTION_DRAFT_COLLECTION=document_extraction_drafts
DOCUMENT_OCR_TIMEOUT_SECONDS=60
DOCUMENT_OCR_MAX_PAGE_BYTES=52428800
DOCUMENT_OCR_LEASE_SECONDS=120
DOCUMENT_OCR_MAX_ATTEMPTS=3
DOCUMENT_OCR_BATCH_SIZE=2
DOCUMENT_OCR_POLL_INTERVAL_SECONDS=2
DOCUMENT_OCR_AUTOMATION_ENABLED=true
DOCUMENT_EXTRACTION_LEASE_SECONDS=60
DOCUMENT_EXTRACTION_MAX_ATTEMPTS=3
DOCUMENT_EXTRACTION_BATCH_SIZE=2
DOCUMENT_EXTRACTION_POLL_INTERVAL_SECONDS=2
DOCUMENT_EXTRACTION_AUTOMATION_ENABLED=true
DOCUMENT_PROMOTION_BATCH_SIZE=10
DOCUMENT_PROMOTION_POLL_INTERVAL_SECONDS=2
DOCUMENT_OUTBOX_LEASE_SECONDS=30
DOCUMENT_OUTBOX_MAX_ATTEMPTS=3
DOCUMENT_OUTBOX_BATCH_SIZE=25
DOCUMENT_OUTBOX_POLL_INTERVAL_SECONDS=1
DOCUMENT_EVENT_TOPIC=clinical.documents.v1
READINESS_TIMEOUT_SECONDS=1.5
LLM_PROVIDER=mock
# Real LLM providers (uncomment and configure one):
# LLM_PROVIDER=medgemma
# MEDGEMMA_MODEL_PATH=C:/models/medgemma-4b-it-Q4_K_M.gguf
# MEDGEMMA_N_GPU_LAYERS=-1
# MEDGEMMA_N_CTX=4096
# MEDGEMMA_MAX_TOKENS=512
# MEDGEMMA_TEMPERATURE=0.1
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_MAX_TOKENS=1024
# ANTHROPIC_TIMEOUT_SECONDS=30.0
SUMMARY_WORKFLOW_ENABLED=false
SUMMARY_OUTBOX_LEASE_SECONDS=30
SUMMARY_OUTBOX_MAX_ATTEMPTS=3
SUMMARY_OUTBOX_BATCH_SIZE=25
SUMMARY_OUTBOX_POLL_INTERVAL_SECONDS=1
SUMMARY_EVENT_TOPIC=clinical.summaries.v1
ELASTICSEARCH_URL=http://localhost:9200
CLINICAL_SEARCH_INDEX_ALIAS=medikiosk-clinical-search
CLINICAL_SEARCH_ENABLED=true
SEARCH_CONSUMER_GROUP=medikiosk-clinical-search-v1

# Real Hindi/English speech: set API_BUILD_TARGET=asr and ASR_PROVIDER=ai4bharat.
# Supply a token with access to the configured Hindi model when required.
API_BUILD_TARGET=runtime
ASR_PROVIDER=mock
ASR_CPU_THREADS=4
ASR_MODEL_REVISION=e9b71b369c048e2c6b634d4c131061c34e441179
ASR_DECODING=ctc
ASR_ENGLISH_PROVIDER=whisper
ASR_ENGLISH_MODEL=openai/whisper-small.en
HUGGINGFACE_TOKEN=
MODEL_WARMUP_ON_START=false
ASR_WARMUP_ON_START=false
VOICE_REDIS_ENABLED=false
VOICE_KAFKA_ENABLED=false
VOICE_CONTEXT_TTL_SECONDS=1800

# Auth
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
